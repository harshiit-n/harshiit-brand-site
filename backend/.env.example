PORT=4000
ALLOWED_ORIGIN=http://localhost:5173

# Set both to enable the /api/admin/* endpoints (protected via HTTP Basic Auth).
# Leave unset to keep admin routes disabled.
ADMIN_USER=
ADMIN_PASSWORD=

# Optional override for the SQLite file location.
# DB_PATH=./data/site.db

# Email notifications: sends you a quick email whenever the contact,
# waitlist, or newsletter form is submitted. Leave RESEND_API_KEY unset to
# disable notifications entirely — the forms still work fine either way.
#
# Uses Resend's HTTP API (https://resend.com), not SMTP — hosts like Render
# block outbound SMTP (port 465/587) entirely, but HTTPS always works.
# Free tier: 3,000 emails/month. Get an API key at resend.com/api-keys.
RESEND_API_KEY=

# Optional: the "from" address shown on notification emails. Without a
# verified domain on Resend, leave unset to use their default
# onboarding@resend.dev sender, which can only send to NOTIFY_EMAIL below
# if that's the address the Resend account itself was created with.
RESEND_FROM_EMAIL=

# Where notifications get sent.
NOTIFY_EMAIL=
