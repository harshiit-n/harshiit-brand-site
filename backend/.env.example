PORT=4000
ALLOWED_ORIGIN=http://localhost:5173

# Set both to enable the /api/admin/* endpoints (protected via HTTP Basic Auth).
# Leave unset to keep admin routes disabled.
ADMIN_USER=
ADMIN_PASSWORD=

# Optional override for the SQLite file location.
# DB_PATH=./data/site.db

# Email notifications: sends you a quick email whenever the contact,
# waitlist, or newsletter form is submitted. Leave all of these unset to
# disable notifications entirely — the forms still work fine either way.
#
# Easiest free option: use your own Gmail with an "App Password"
# (Google Account -> Security -> 2-Step Verification -> App passwords).
# Do NOT use your normal Gmail password here.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=the16digitapppassword
#
# Or any transactional email provider's SMTP credentials (Resend, Postmark,
# Mailgun, etc.) work the same way — just swap in their host/port/user/pass.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Where notifications get sent. Defaults to SMTP_USER if left blank.
NOTIFY_EMAIL=
