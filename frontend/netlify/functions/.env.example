# These are NOT loaded automatically from this file — set them as regular
# (non-VITE_) environment variables in the Netlify dashboard, under
# Project configuration > Environment variables. Netlify Functions can read
# any env var set there at runtime; only VITE_* ones get bundled into the
# public frontend, so these stay server-side only.

# Neon Postgres connection string (Neon console -> your project -> Connect).
# Use the "pooled connection" string. Run schema.sql against this database
# once before using create-message.js or track.js.
DATABASE_URL=

# Reuse the same admin credentials as the Render backend (or pick new ones —
# they're independent). Protects create-message and tracking-report; the
# public track.js and open.js endpoints don't use these.
ADMIN_USER=
ADMIN_PASSWORD=
