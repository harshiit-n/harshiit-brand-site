# Production API base URL — set on Netlify, not needed locally (Vite proxies
# /api to the local backend in dev; see vite.config.js).
VITE_API_URL=

# GA4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable analytics
# entirely — the site works fine either way, nothing loads until a visitor
# accepts the consent banner regardless.
VITE_GA_MEASUREMENT_ID=

# Per-recipient link tracking (Step C) runs entirely server-side via Netlify
# Functions — see frontend/netlify/functions/.env.example for the env vars
# those need (DATABASE_URL, ADMIN_USER, ADMIN_PASSWORD). Nothing here.
